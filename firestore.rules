rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Global Hardened Helpers
    // ==========================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'serdarmujdattosun@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ==========================================
    // Validation Blueprints
    // ==========================================
    function isValidCompanyBrandingLogo(data) {
      return data.keys().hasAll(['logoUrl', 'updatedAt', 'updatedByUid']) &&
        data.keys().hasOnly(['logoUrl', 'updatedAt', 'updatedByUid']) &&
        data.logoUrl is string &&
        data.logoUrl.size() >= 1 &&
        data.logoUrl.size() <= 900000 &&
        !data.logoUrl.matches('^blob:.*') &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time &&
        data.updatedByUid is string &&
        data.updatedByUid.size() >= 1 &&
        data.updatedByUid.size() <= 128 &&
        data.updatedByUid == request.auth.uid;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['email', 'grantedAt']) &&
        data.keys().hasOnly(['email', 'grantedAt']) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.grantedAt is timestamp &&
        data.grantedAt == request.time;
    }

    function isValidUserAccountTheme(data) {
      return data.keys().hasAll(['themeId', 'updatedAt', 'ownerUid']) &&
        data.keys().hasOnly(['themeId', 'updatedAt', 'ownerUid']) &&
        data.themeId is string &&
        data.themeId.size() >= 5 &&
        data.themeId.size() <= 32 &&
        data.themeId in ['kurumsal_saf', 'sicak_kagit', 'serin_sis', 'gece_arduvaz', 'komur_orman'] &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time &&
        data.ownerUid is string &&
        data.ownerUid.size() >= 1 &&
        data.ownerUid.size() <= 128 &&
        data.ownerUid == request.auth.uid;
    }

    // ==========================================
    // Collection Rules
    // ==========================================
    match /company_branding/{brandingId} {
      // Single non-PII branding document ('logo') readable across all browsers/devices on boot
      allow get: if isValidId(brandingId) && brandingId == 'logo';
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(brandingId) &&
        brandingId == 'logo' &&
        isValidCompanyBrandingLogo(incoming());

      allow update: if isAdmin() &&
        isValidId(brandingId) &&
        brandingId == 'logo' &&
        isValidCompanyBrandingLogo(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['logoUrl', 'updatedAt', 'updatedByUid']);

      allow delete: if isAdmin() &&
        isValidId(brandingId) &&
        brandingId == 'logo';
    }

    match /admins/{uid} {
      allow get: if isVerified() &&
        isValidId(uid) &&
        (request.auth.uid == uid || isAdmin());
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(uid) &&
        isValidAdminRole(incoming());

      allow update: if isAdmin() &&
        isValidId(uid) &&
        isValidAdminRole(incoming()) &&
        incoming().email == existing().email &&
        incoming().grantedAt == existing().grantedAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'grantedAt']);

      allow delete: if isAdmin() &&
        isValidId(uid) &&
        uid != request.auth.uid;
    }

    match /user_preferences/{uid}/account_themes/{accountKey} {
      allow get: if isVerified() &&
        isValidId(uid) &&
        isValidId(accountKey) &&
        request.auth.uid == uid;

      allow list: if isVerified() &&
        isValidId(uid) &&
        request.auth.uid == uid &&
        resource.data.ownerUid == request.auth.uid;

      allow create: if isVerified() &&
        isValidId(uid) &&
        isValidId(accountKey) &&
        request.auth.uid == uid &&
        isValidUserAccountTheme(incoming());

      allow update: if isVerified() &&
        isValidId(uid) &&
        isValidId(accountKey) &&
        request.auth.uid == uid &&
        isValidUserAccountTheme(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['themeId', 'updatedAt', 'ownerUid']);

      allow delete: if isVerified() &&
        isValidId(uid) &&
        isValidId(accountKey) &&
        request.auth.uid == uid;
    }
  }
}

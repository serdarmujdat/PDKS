# ==========================================
# Sunucu ve Uygulama Yapılandırması
# ==========================================
PORT=3000
APP_URL="http://localhost:3000"

# Gemini API Anahtarı (Opsiyonel - Sunucu tarafı AI özellikleri için)
GEMINI_API_KEY="your_gemini_api_key_here"

# PDKS Sistem & Duvar QR Tokenı
PDKS_API_KEY="PDKS-DEMO-WALL-TOKEN-CHANGE-ME"
VITE_PDKS_API_KEY="PDKS-DEMO-WALL-TOKEN-CHANGE-ME"

# Demo Yönetici & Kiosk Şifreleri (Üretim ortamında mutlaka değiştirin)
ADMIN_DEFAULT_PASSWORD="change_me_admin_password"
VITE_ADMIN_DEFAULT_PASSWORD="change_me_admin_password"
KIOSK_LOCK_PASSWORD="change_me_kiosk_pin"

# Gizli Süper Yönetici Kimliği (Üretim ortamında tanımlayın - boş bırakılabilir)
SUPER_ADMIN_USER=""
SUPER_ADMIN_PASS=""

# ==========================================
# Firebase Yapılandırması (Opsiyonel Bulut Senkronizasyonu)
# ==========================================
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:example_app_id"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"
